{
  "name": "APP_NAME_HERE",
  "version": "1.0.0",
  "description": "Desktop app using Electron with Vite as renderer",
  "license": "LICENSE_HERE",
  "author": "NAME_HERE",
  "type": "module",
  "main": "main/ElectronMain.js",
  "build": {
    "appId": "com.NAME_HERE.APP_NAME_HERE",
    "productName": "APP_NAME_HERE",
    "copyright": "Copyright © 2022 NAME_HERE",
    "mac": {
      "icon": "assets/icons/logo/logo.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "icon": "assets/icons/logo/logo.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icons/logo/logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DocForge",
      "runAfterFinish": false,
      "include": "Installer.nsh",
      "perMachine": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icons/logo/logo.ico",
      "uninstallerIcon": "assets/icons/logo/logo.ico",
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "npm-run-all -p dev:renderer dev:electron",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }; if (Test-Path out) { Remove-Item -Recurse -Force out }\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "help": "echo \"use 'dev' for development\" && echo \"use 'build' for production build\" && echo \"use 'start' for electron-forge start\" && echo \"use 'dist' for electron-builder\""
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@rollup/plugin-alias": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "npm-run-all": "^4.1.5",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.15",
    "electron-squirrel-startup": "^1.0.1"
  }
}
